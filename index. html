<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ReyMarket - Marketplace Colombiano</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: #111827;
      color: white;
      padding: 20px;
      text-align: center;
    }

    header h1 {
      margin: 0;
      font-size: 32px;
    }

    header p {
      margin: 8px 0 0;
    }

    .buscador {
      padding: 20px;
      text-align: center;
      background: white;
    }

    input {
      width: 90%;
      max-width: 500px;
      padding: 14px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }

    .categorias {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 15px;
      background: white;
    }

    .categoria {
      background: #e5e7eb;
      padding: 12px 18px;
      border-radius: 20px;
      white-space: nowrap;
    }

    .productos {
      padding: 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 15px;
    }

    .producto {
      background: white;
      border-radius: 12px;
      padding: 15px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .producto .imagen {
      font-size: 55px;
      padding: 15px;
    }

    .precio {
      font-size: 20px;
      font-weight: bold;
    }

    button {
      background: #16a34a;
      color: white;
      border: 0;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 15px;
    }

    footer {
      background: #111827;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 20px;
    }
  </style>
</head>

<body>

  <header>
    <h1>👑 ReyMarket</h1>
    <p>Marketplace colombiano</p>
  </header>

  <div class="buscador">
    <input type="text" placeholder="🔎 ¿Qué estás buscando?">
  </div>

  <div class="categorias">
    <div class="categoria">📱 Tecnología</div>
    <div class="categoria">👕 Ropa</div>
    <div class="categoria">🏠 Hogar</div>
    <div class="categoria">💄 Belleza</div>
    <div class="categoria">⚽ Deportes</div>
  </div>

  <section class="productos">

    <div class="producto">
      <div class="imagen">📱</div>
      <h3>Celulares</h3>
      <p>Encuentra productos de tecnología.</p>
      <div class="precio">Ver productos</div>
      <br>
      <button>Comprar</button>
    </div>

    <div class="producto">
      <div class="imagen">👕</div>
      <h3>Moda</h3>
      <p>Ropa y accesorios.</p>
      <div class="precio">Ver productos</div>
      <br>
      <button>Comprar</button>
    </div>

    <div class="producto">
      <div class="imagen">🏠</div>
      <h3>Hogar</h3>
      <p>Productos para tu hogar.</p>
      <div class="precio">Ver productos</div>
      <br>
      <button>Comprar</button>
    </div>

  </section>

  <footer>
    <h3>ReyMarket 🇨🇴</h3>
    <p>Compra y vende en Colombia.</p>
    <p>© 2026 ReyMarket</p>
  </footer>

</body>
</html>